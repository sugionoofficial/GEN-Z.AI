# .dev.vars.example — salin menjadi .dev.vars lalu isi nilainya.
#
#   cp .dev.vars.example .dev.vars
#
# File .dev.vars TIDAK boleh di-commit (sudah masuk .gitignore).
# Gunakan nilai development, jangan pakai secret production.

# ---------------------------------------------------------
# Wajib — tanpa ini setiap /api/* membalas 500
# ---------------------------------------------------------
SUPABASE_URL=https://rvgioyenjgkprnssfpfr.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_ANON_KEY=sb_publishable_-Fq__LVjbaAe2e3YkhYnQg_-PLLDM1R

# ---------------------------------------------------------
# Disarankan
# ---------------------------------------------------------
# 32-byte key untuk mengenkripsi credential provider di database
PROVIDER_CREDENTIAL_ENCRYPTION_KEY=<32-byte-secret>

# ---------------------------------------------------------
# Opsional
# ---------------------------------------------------------
# SIGHTENGINE_API_USER=<user>
# SIGHTENGINE_API_SECRET=<secret>
# OPENKEY_API_KEY=<key>
# GITHUB_PAT=<token: untuk upscale Actions & Admin Copilot>
#
# TempMail (menu admin "TempMail" -> /email.html) — lihat TEMPMAIL-SETUP.md
# URL API Tempmail-MCP yang sudah di-deploy (tanpa garis miring di akhir).
# Tanpa nilai ini /api/tempmail membalas error konfigurasi.
# TEMPMAIL_API_URL=https://tempmail.example.com
# Provider yang dicoba lebih dulu (default: gmail). Boleh daftar dipisah koma;
# "auto" selalu ditambahkan sebagai fallback provider sehat lain.
# TEMPMAIL_PROVIDER=gmail

# OpenClips — lihat OPENCLIPS-SETUP.md
# OPENCLIPS_AUTH_TOKEN=<api-key-bearer-atau-json-oauth>
# OPENCLIPS_WORKSPACE_ID=<workspace-integer-id-bila-akun-memiliki-beberapa-workspace>
# OPENCLIPS_MCP_URL=https://mcp.openclips.ai
# OPENCLIPS_LOGIN_STATE_SECRET=<random-long-secret>
# OPENCLIPS_DISABLE_SUPABASE_VAULT=1  # hanya untuk test/lokal
