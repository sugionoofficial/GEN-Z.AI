{
  "name": "genz-studio-flow-companion",
  "version": "0.2.1",
  "private": true,
  "description": "Windows companion with visible Google Flow UI automation for GEN-Z.AI STUDIO FLOW",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "dist:win": "electron-builder --win nsis portable --publish never"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "ai.genz.studioflow.companion",
    "productName": "GEN-Z.AI STUDIO FLOW Companion",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "task-validator.cjs",
      "flow-ui-automation.cjs",
      "reference-stager.cjs",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "GEN-Z-STUDIO-FLOW-Companion-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "sugionoofficial",
        "repo": "GEN-Z.AI",
        "releaseType": "release",
        "publishAutoUpdate": true
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
