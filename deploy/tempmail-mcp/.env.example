# Salin menjadi .env lalu isi. JANGAN commit .env.
# Domain harus sudah punya A/AAAA record ke VPS ini (port 80/443 terbuka).
TEMPMAIL_DOMAIN=tempmail.example.com

# Email untuk notifikasi sertifikat Let's Encrypt (bukan akun Gmail provider).
ACME_EMAIL=admin@example.com

# Akun Gmail yang dipakai provider IMAP Tempmail-MCP.
# Pakai App Password 16 digit, BUKAN password akun.
# Rotasi kredensial lama karena .env di repo upstream pernah ter-commit publik.
GMAIL_EMAIL=akun@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
